# LLM (agent)
GLM_API_KEY=
GLM_MODEL=glm-5.3
# GLM Coding Plan endpoint; pay-as-you-go API keys use https://api.z.ai/api/paas/v4/
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/
GLM_MAX_TOKENS=1200
GLM_TEMPERATURE=0.2
GLM_TIMEOUT=30
# enabled | disabled - thinking mode slows answers down a lot
GLM_THINKING=disabled

# Agent - session memory lives only in process memory, never in db or logs
AGENT_MAX_TOOL_ROUNDS=5
SESSION_TTL_SECONDS=1800
SESSION_MAX_MESSAGES=20

# Data sources
AIRLY_API_KEY=

# Database
POSTGRES_USER=kryzio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kryzio
DATABASE_URL=postgresql://kryzio:change-me@db:5432/kryzio

# Service URLs
API_URL=http://api:8000
AGENT_URL=http://agent:8001
CORS_ORIGINS=http://localhost:5173

# Demo mode - presentation only, never enable in production
DEMO_MODE=false

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_AGENT_URL=http://localhost:8001
VITE_DEMO_MODE=false
