# LLM (agent)
GLM_API_KEY=
GLM_MODEL=glm-5.3
# GLM Coding Plan endpoint; pay-as-you-go API keys use https://api.z.ai/api/paas/v4/
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/
GLM_MAX_TOKENS=1200
GLM_TEMPERATURE=0.2
GLM_TIMEOUT=30
# enabled | disabled - thinking mode slows answers down a lot
GLM_THINKING=disabled

# Agent - session memory lives only in process memory, never in db or logs
AGENT_MAX_TOOL_ROUNDS=3
AGENT_MAX_TOOL_CALLS_PER_ROUND=6
AGENT_REQUEST_DEADLINE_S=45
SESSION_TTL_SECONDS=1800
SESSION_MAX_MESSAGES=20
SESSION_MAX_COUNT=5000
CHAT_RATE_LIMIT_PER_MINUTE=10

# api - public geocoding limit per client IP
GEOCODE_RATE_LIMIT_PER_MINUTE=30
# Random secret shared by api and agent; agent calls skip the per-IP geocoding limit
API_INTERNAL_TOKEN=

# development | production (production hides /docs and /openapi.json)
APP_ENV=development

# Data sources
# Airly is used only when a key is set (rate limit: one refresh every 2h)
AIRLY_API_KEY=
# Nominatim usage policy requires an identifying User-Agent with contact
NOMINATIM_USER_AGENT=KryzIO/1.0 (HackYeah2026; https://github.com/Ajek1993/HackYeah2026)

# Database
POSTGRES_USER=kryzio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kryzio
DATABASE_URL=postgresql://kryzio:change-me@db:5432/kryzio

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Service URLs
API_URL=http://api:8000
AGENT_URL=http://agent:8001
CORS_ORIGINS=http://localhost:5173

# Demo mode - presentation only, never enable in production
DEMO_MODE=false
# Sent as X-Demo-Token to switch scenarios; empty disables switching
DEMO_ADMIN_TOKEN=
DEMO_TTL_MINUTES=30

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_AGENT_URL=http://localhost:8001
VITE_DEMO_MODE=false
# Same value as DEMO_ADMIN_TOKEN; ends up in the presentation bundle, so it only guards against accidental switching
VITE_DEMO_TOKEN=
