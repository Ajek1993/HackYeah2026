# Production image: static Vite build served by unprivileged nginx (T24)
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Public, browser-side settings: Vite inlines them into the bundle at build time
ARG VITE_API_URL
ARG VITE_AGENT_URL
ARG VITE_DEMO_MODE=false
ARG VITE_DEMO_TOKEN=

COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY nginx/ /etc/nginx/
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
