# === KryzIO Production (.env on VPS) ===

# LLM (agent)
GLM_API_KEY=<twoj-klucz>
GLM_MODEL=glm-5.3
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/
GLM_MAX_TOKENS=1200
GLM_TEMPERATURE=0.2
GLM_TIMEOUT=30
GLM_THINKING=disabled

# Agent
AGENT_MAX_TOOL_ROUNDS=3
AGENT_MAX_TOOL_CALLS_PER_ROUND=6
AGENT_REQUEST_DEADLINE_S=45
SESSION_TTL_SECONDS=1800
SESSION_MAX_MESSAGES=20
SESSION_MAX_COUNT=5000
CHAT_RATE_LIMIT_PER_MINUTE=10

# API
GEOCODE_RATE_LIMIT_PER_MINUTE=30
API_INTERNAL_TOKEN=<losowy-token-32-znaki>
APP_ENV=production
NOMINATIM_USER_AGENT=KryzIO/1.0 (HackYeah2026; https://github.com/Ajek1993/HackYeah2026)

# Airly (optional)
AIRLY_API_KEY=

# Database
POSTGRES_USER=kryzio
POSTGRES_PASSWORD=<silne-haslo>
POSTGRES_DB=kryzio
DATABASE_URL=postgresql://kryzio:<silne-haslo>@db:5432/kryzio

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Service URLs (internal container-to-container)
API_URL=http://api:8000
AGENT_URL=http://agent:8001
CORS_ORIGINS=https://kryzio.goveris.pl

# Frontend (browser-side, through nginx reverse proxy)
VITE_API_URL=https://kryzio.goveris.pl/api
VITE_AGENT_URL=https://kryzio.goveris.pl/agent
VITE_DEMO_MODE=false

DEMO_MODE=false
